{
  "name": "tocscrape",
  "version": "1.0.0",
  "description": "Daily scheduled scraper for journal table of contents with social media posting",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "scrape": "node src/scraper.js",
    "post": "node src/social-poster.js"
  },
  "keywords": [
    "web-scraping",
    "cheerio",
    "social-media",
    "automation",
    "github-actions"
  ],
  "author": "bmordue",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bmordue/tocscrape.git"
  },
  "bugs": {
    "url": "https://github.com/bmordue/tocscrape/issues"
  },
  "homepage": "https://github.com/bmordue/tocscrape#readme"
}